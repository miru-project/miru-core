# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

/tmp
.vscode/launch.json
/extensions

# Individual/per-site extension implementations and their tests must NOT live
# in this repo -- they belong in their own extension repository. Only synthetic
# fixtures under testdata/ are allowed (they exercise the runtime, not a site).
pkg/extension/*/extensions/
pkg/extension/golang/extensions/
pkg/extension/js/extensions/

miru.db
config.json
miru
*jar
*aar
__debug_bin*
miru_core.log
.agent
miru_cli
miru_core_crash.log
